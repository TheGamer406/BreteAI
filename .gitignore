# --- Datos personales / privados (NO subir a un repo público) ---
resources/

# El perfil real puede estar también en config/ si lo copias ahí
config/perfil.toon

# --- Secretos ---
.env
.env.*
!.env.example
*.pem
*.key

# --- graphify: ignorar interno/máquina, conservar grafo y reporte ---
graphify-out/.graphify_*
graphify-out/cache/
graphify-out/cost.json
# Backups fechados que crea el hook al reconstruir (uno por día que cambia el
# grafo) — son artefactos locales, el grafo bueno está en graphify-out/graph.json
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# --- Sistema / editores ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
